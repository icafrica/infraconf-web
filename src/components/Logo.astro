---
/**
 * InfraConf Africa — Monogram Logo Mark ("ica")
 * Cluster Mesh Topology Direction (Server Pillar, Container Loop, Gateway Apex, Subnet Bus)
 *
 * Props:
 *   size    — height in pixels (default 32)
 *   variant — "dark" (default) | "light" | "mono"
 *   chip    — boolean, whether to show chip background card & grid (default false)
 */
interface Props {
  size?: number;
  variant?: 'dark' | 'light' | 'mono';
  chip?: boolean;
  class?: string;
}

const { size = 32, variant = 'dark', chip = false, class: className = '' } = Astro.props;

const width = Math.round(size * (68 / 48));

const colors = {
  dark: {
    bg: '#05120C',
    border: 'rgba(127, 255, 197, 0.35)',
    grid: '#7FFFC5',
    gridOpacity: 0.22,
    bus: '#7FFFC5',
    stem: '#FFFFFF',
    mintDot: '#7FFFC5',
    amber: '#E8A030',
  },
  light: {
    bg: '#EBF9F1',
    border: '#2E7552',
    grid: '#1D4C37',
    gridOpacity: 0.25,
    bus: '#1D4C37',
    stem: '#0F2B1F',
    mintDot: '#1D4C37',
    amber: '#D97706',
  },
  mono: {
    bg: 'none',
    border: 'currentColor',
    grid: 'none',
    gridOpacity: 0,
    bus: 'currentColor',
    stem: 'currentColor',
    mintDot: 'currentColor',
    amber: 'currentColor',
  },
}[variant];
---

<svg
  class={className}
  width={width}
  height={size}
  viewBox="0 0 68 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  role="img"
>
  {chip && variant !== 'mono' && (
    <>
      <!-- Outer Server Module Chip -->
      <rect x="0.75" y="0.75" width="66.5" height="46.5" rx="9.25" fill={colors.bg} stroke={colors.border} stroke-width="1.5"/>

      <!-- Background Tech Grid / Circuit Traces -->
      <path d="M 6 16 H 62 M 6 32 H 62" stroke={colors.grid} stroke-width="0.9" opacity={colors.gridOpacity} stroke-dasharray="2 4"/>
      <path d="M 13 6 V 42 M 34 6 V 42 M 55 6 V 42" stroke={colors.grid} stroke-width="0.9" opacity={colors.gridOpacity} stroke-dasharray="2 4"/>
    </>
  )}

  <!-- Subnet Data Bus Connector Trace -->
  <line x1="13" y1="27" x2="47" y2="27" stroke={colors.bus} stroke-width="1" stroke-dasharray="2 2" opacity={variant === 'mono' ? 0.6 : 0.45}/>

  <!-- Letter 'i' — Server Node Status Pillar -->
  <line x1="13" y1="20" x2="13" y2="34" stroke={colors.stem} stroke-width="3.5" stroke-linecap="round"/>
  <circle cx="13" cy="12" r="2.5" fill={colors.mintDot}/>
  <circle cx="13" cy="12" r="4.5" fill={colors.mintDot} opacity="0.35"/>

  <!-- Letter 'c' — Container / Network Loop -->
  <path d="M 31 20 Q 22 20 22 27 Q 22 34 31 34" stroke={colors.stem} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="31" cy="20" r="1.5" fill={colors.mintDot}/>

  <!-- Letter 'a' — Cluster Node / Gateway Apex -->
  <path d="M 39 34 L 47 20 L 55 34" stroke={colors.stem} stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
  <line x1="42" y1="28" x2="52" y2="28" stroke={colors.amber} stroke-width="3" stroke-linecap="round"/>
  <circle cx="47" cy="20" r="2" fill={colors.amber}/>
</svg>
